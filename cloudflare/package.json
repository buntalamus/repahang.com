{
  "name": "refpahang-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:appointment-core": "node --no-warnings tests/appointment-response-core.mjs",
    "test:appointment-delivery": "node --no-warnings tests/appointment-delivery.mjs",
    "test:appointment-reply": "node --no-warnings tests/appointment-reply.mjs",
    "test:appointment-email-link": "node --no-warnings tests/appointment-email-link.mjs",
    "test:appointment-expiry": "node --no-warnings tests/appointment-expiry.mjs",
    "test:appointment-audit": "node --no-warnings tests/appointment-audit.mjs",
    "test:assessment-token": "node --no-warnings tests/assessment-token.mjs",
    "test:assessment-reports": "node --no-warnings tests/assessment-reports.mjs",
    "test:assessment-draft": "node --no-warnings tests/assessment-draft.mjs",
    "test:admin-appointments": "node --no-warnings tests/admin-appointments.mjs",
    "test:admin-appointment-create": "node --no-warnings tests/admin-appointment-create.mjs",
    "test:telegram-blast-preview": "node --no-warnings tests/telegram-blast-preview.mjs",
    "test:print-assessment": "node --no-warnings tests/print-assessment.mjs",
    "test:chair-approval-link": "node --no-warnings tests/chair-approval-link.mjs",
    "test:chair-confirm-core": "node --no-warnings tests/chair-confirm-core.mjs",
    "test:report-submission": "node --no-warnings tests/report-submission.mjs",
    "test:report-admin-override": "node --no-warnings tests/report-admin-override.mjs",
    "test:futsal-form": "node --no-warnings tests/futsal-form.mjs",
    "test:chair-config": "node --no-warnings tests/chair-config.mjs",
    "build:frontend": "npm --prefix ../frontend run build:prod",
    "dev": "wrangler dev",
    "deploy:staging": "npm run typecheck && npm run build:frontend && wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "~5.9.3",
    "wrangler": "4.150.0"
  }
}
