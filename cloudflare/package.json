{
  "name": "refpahang-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:appointment-audit": "node --no-warnings tests/appointment-audit.mjs",
    "test:assessment-token": "node --no-warnings tests/assessment-token.mjs",
    "test:assessment-reports": "node --no-warnings tests/assessment-reports.mjs",
    "test:assessment-draft": "node --no-warnings tests/assessment-draft.mjs",
    "test:admin-appointments": "node --no-warnings tests/admin-appointments.mjs",
    "test:lantikan-write": "node --no-warnings tests/lantikan-write.mjs",
    "test:appointment-response": "node --no-warnings tests/appointment-response.mjs",
    "test:telegram-webhook": "node --no-warnings tests/telegram-webhook.mjs",
    "test:laporan-flow": "node --no-warnings tests/laporan-flow.mjs",
    "test:telegram-blast-preview": "node --no-warnings tests/telegram-blast-preview.mjs",
    "test:external-telegram-blast": "node --no-warnings tests/external-telegram-blast.mjs",
    "test:kelas3-welcome": "node --no-warnings tests/kelas3-welcome.mjs",
    "test:print-assessment": "node --no-warnings tests/print-assessment.mjs",
    "test:futsal-form": "node --no-warnings tests/futsal-form.mjs",
    "test:registration-pdf": "node --no-warnings tests/registration-pdf.mjs",
    "test:application-submit": "node --no-warnings tests/application-submit.mjs",
    "test:chair-config": "node --no-warnings tests/chair-config.mjs",
    "build:frontend": "npm --prefix ../frontend run build:prod",
    "dev": "wrangler dev",
    "deploy:staging": "npm run typecheck && npm run build:frontend && wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "~5.9.3",
    "wrangler": "4.150.0"
  }
}
