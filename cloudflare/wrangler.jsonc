{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refpahang-staging-20261013",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "../frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "refpahang-staging-20261013-hanafi51",
      "database_id": "1ae0b043-c799-4ac3-bdc7-07fc564cdb8b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "refpahang-staging-20261013-media"
    }
  ],
  "vars": {
    "STAGING_AUTH_ENABLED": "0",
    "STAGING_WRITES_ENABLED": "0"
  }
}
