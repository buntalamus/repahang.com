{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refpahang-staging-20261013",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-13",
  "routes": [{ "pattern": "ujian.refpahang.com", "custom_domain": true }],
  "assets": {
    "directory": "../frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "refpahan_pahang_staging_20261015",
      "database_id": "eb7f6762-fd38-4324-969f-ba3c38aa058b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "refpahang-staging-20261013-media"
    }
  ],
  "browser": { "binding": "BROWSER" },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "admin@refpahang.com",
        "daftar@refpahang.com",
        "lantikan@refpahang.com",
        "support@refpahang.com",
        "pengesahan@refpahang.com"
      ]
    }
  ],
  "vars": {
    "BASE_URL": "https://ujian.refpahang.com",
    "STAGING_AUTH_ENABLED": "1",
    "STAGING_LOGIN_EMAILS": "staging-admin@example.invalid,staging-pp@example.invalid,staging-pp-ra@example.invalid",
    "STAGING_WRITES_ENABLED": "0",
    "APPOINTMENT_DELIVERY_ENABLED": "0",
    "REPORT_DELIVERY_ENABLED": "0",
    "BULK_EMAIL_ENABLED": "0",
    "MAILBOX_SEND_ENABLED": "0"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
