// Production Worker for refpahang.com. Deploy only during cutover, after the
// final dump is imported: see "Langkah cutover" in docs/cloudflare_migration_prep.md.
// Secrets (never in this file): SMTP_HOST/PORT, MAIL_*_USER/NAME/PASS, and
// TELEGRAM_BOT_TOKEN. Do NOT set STAGING_QA_WRITE_TOKEN or STAGING_EMAIL_REDIRECT here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refpahang",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-13",
  // Preserve the existing production Dashboard settings during CLI releases.
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "routes": [
    { "pattern": "refpahang.com", "custom_domain": true },
    { "pattern": "www.refpahang.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*", "/app/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "refpahan_pahang_production",
      // Filled in by `wrangler d1 create refpahan_pahang_production` at cutover.
      "database_id": "ffad00eb-6437-4c03-87ba-570a5f311eb7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "refpahang-production-media"
    }
  ],
  "browser": { "binding": "BROWSER" },
  "services": [{"binding":"ORIGINAL_TEMPLATES","service":"refpahang-original-templates"},{"binding":"JFA_C13_SERVICE","service":"jerantutfa-refpahang-sync"}],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "admin@refpahang.com",
        "daftar@refpahang.com",
        "lantikan@refpahang.com",
        "support@refpahang.com",
        "pengesahan@refpahang.com"
      ]
    }
  ],
  // Each address becomes an Email Routing rule to this Worker on deploy.
  "addresses": [
    "admin@refpahang.com",
    "daftar@refpahang.com",
    "lantikan@refpahang.com",
    "support@refpahang.com",
    "pengesahan@refpahang.com"
  ],
  // The STAGING_* names are historical: they gate every write path, so all are
  // on in production. STAGING_LOGIN_EMAILS is left unset so every user can log in.
  "vars": {
    "BASE_URL": "https://refpahang.com",
    "EMAIL_TRANSPORT": "cloudflare-email",
    "TELEGRAM_BOT_USERNAME": "refpahang_bot",
    "STAGING_AUTH_ENABLED": "1",
    "STAGING_WRITES_ENABLED": "1",
    "APPOINTMENT_DELIVERY_ENABLED": "1",
    "REPORT_DELIVERY_ENABLED": "1",
    "BULK_EMAIL_ENABLED": "1",
    "MAILBOX_SEND_ENABLED": "1",
    "MAILBOX_IMAP_ENABLED": "1",
    // Mobile app push (FCM). Also needs the FCM_SERVICE_ACCOUNT secret.
    "PUSH_ENABLED": "1",
    // Android app download; the app's update prompt links here.
    "MOBILE_ANDROID_URL": "https://refpahang.com/app/refpahang.apk",
    // Raise for native releases only; Dart changes ship as Shorebird patches.
    "MOBILE_MIN_VERSION": "1.2.0",
    "MOBILE_LATEST_VERSION": "1.4.0",
    // Web Push (PWA / iPhone). Private key is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BO4kEmtoPWuRdkdFQttS_KLYhetpVzDsvdGp3vVH0-TV6DyFp3pR4D74sG9KBtrW_Swlvm4creFEGIzM6UK5aiE",
    "VAPID_SUBJECT": "mailto:sokongan@pbnppahang.my"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
